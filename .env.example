# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Lihat docs/architecture.md bagian 8.

# mock = chat tiruan (Tahap 1), supabase = chat sungguhan (Tahap 2)
VITE_CHAT_MODE=mock

# Diisi di Tahap 2 (publik, boleh ada di website):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_EMAIL=
